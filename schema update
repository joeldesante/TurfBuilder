-- =============================================================================
-- CATALOGUES
-- Shared lookup tables. Not org-scoped. New entries can be added at runtime
-- by plugins without schema migrations.
-- =============================================================================

TABLE universe.entity_type {
  -- Catalogue of all valid entity types. Plugins can register new types by
  -- inserting a row here. The type_id column on public_entity and org_entity is
  -- validated against this table by the set_entity_type trigger.
  id:          UUID
  slug:        TEXT -- Machine-readable identifier (e.g. 'person', 'location', 'organization', 'asset', 'vehicle')
  name:        TEXT -- Human-readable label (e.g. 'Person', 'Location', 'Organization')
  description: NULLABLE TEXT
  created_at:  TIMESTAMPTZ
  # UNIQUE CONSTRAINT on slug
  # RLS ENABLED
  # POLICY public_read -- catalogue is globally readable; only infrastructure can write
}

TABLE universe.organization_type {
  -- Catalogue of all valid organization sub-types. Plugins can register new types
  -- by inserting a row here (e.g. a logistics plugin might add 'carrier' or 'depot').
  id:          UUID
  slug:        TEXT -- Machine-readable identifier (e.g. 'business', 'non-profit', 'government', 'carrier')
  name:        TEXT -- Human-readable label (e.g. 'Business', 'Non-Profit', 'Government')
  description: NULLABLE TEXT
  created_at:  TIMESTAMPTZ
  # UNIQUE CONSTRAINT on slug
  # RLS ENABLED
  # POLICY public_read -- catalogue is globally readable; only infrastructure can write
}

TABLE universe.relationship_type {
  -- Shared catalogue of all valid relationship types. Not org-scoped — types are
  -- defined at the system level and reused across all orgs and both tiers.
  -- New types can be added at runtime by plugins without schema migrations.
  -- inverse_slug and inverse_name allow the relationship to be displayed correctly
  -- from either direction without storing two rows.
  -- e.g. 'employed_by' (Jane → Five Guys) has inverse 'employs' (Five Guys → Jane)
  id:           UUID
  slug:         TEXT -- Machine-readable identifier (e.g. 'located_at', 'resident', 'employed_by')
  name:         TEXT -- Human-readable label for the forward direction (e.g. 'Employed By')
  inverse_slug: TEXT -- Machine-readable identifier for the reverse direction (e.g. 'employs')
  inverse_name: TEXT -- Human-readable label for the reverse direction (e.g. 'Employs')
  description:  NULLABLE TEXT
  created_at:   TIMESTAMPTZ
  # UNIQUE CONSTRAINT on slug
  # UNIQUE CONSTRAINT on inverse_slug
  # RLS ENABLED
  # POLICY public_read -- catalogue is globally readable; only infrastructure can write
}

