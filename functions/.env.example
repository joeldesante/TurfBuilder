DATABASE_URL=postgres://user:password@host:25060/turfbuilder?sslmode=require
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=

# Optional. Rows per commit, and how long to rest after each batch as a multiple of
# the time the batch took (1 = about half duty, 0 = no pacing).
IMPORT_BATCH_SIZE=500
IMPORT_PACE_RATIO=1

# Local only: the dev server (npm run dev) that stands in for DigitalOcean's invoke API.
FUNCTIONS_LOCAL_KEY=
FUNCTIONS_LOCAL_PORT=3233
