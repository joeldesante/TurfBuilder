-- =============================================================================
-- ENTITY TABLES
-- Base identity records. Never mutated. All domain data lives in version tables.
-- =============================================================================

TABLE universe.public_entity {
  -- Shared across all orgs. No org_id — these records are globally visible.
  id:         UUID
  type_id:    NULLABLE FK -> universe.entity_type.id -- Set automatically by trigger on first version row insert. Immutable once set — any attempt to change it will be rejected by the trigger.
  source_ref: NULLABLE TEXT -- The identifier assigned by the external source system (e.g. Overture Maps feature ID, voter file record number). NULLABLE because not all entities originate from an external system.
  created_at: TIMESTAMPTZ
  # TRIGGER: on INSERT to any version table (public_person, public_location, public_organization),
  #   automatically sets type_id on this table by looking up the matching slug in universe.entity_type.
  #   If type_id is already set and does not match, the insert is rejected with an exception.
  #   Type is intentionally NULLABLE at the entity level because it is set by the version table trigger, not by the caller.
  # RLS ENABLED
  # POLICY public_entity_read -- all public entities are visible to all orgs
  # INDEX (type_id)
  # INDEX (source_ref)
}

TABLE universe.org_entity {
  -- Private to a single org. Physically separate from public_entity to prevent accidental data leakage.
  id:         UUID
  org_id:     FK -> auth.organization.id
  type_id:    NULLABLE FK -> universe.entity_type.id -- Set automatically by trigger on first version row insert. Immutable once set — any attempt to change it will be rejected by the trigger.
  source_ref: NULLABLE TEXT -- The identifier assigned by the external source system (e.g. Overture Maps feature ID, voter file record number). NULLABLE because not all entities originate from an external system.
  created_at: TIMESTAMPTZ
  # TRIGGER: on INSERT to any version table (org_person, org_location, org_organization),
  #   automatically sets type_id on this table by looking up the matching slug in universe.entity_type.
  #   If type_id is already set and does not match, the insert is rejected with an exception.
  #   Type is intentionally NULLABLE at the entity level because it is set by the version table trigger, not by the caller.
  # RLS ENABLED
  # POLICY org_isolation
  # INDEX (org_id)
  # INDEX (type_id)
  # INDEX (source_ref)
}

