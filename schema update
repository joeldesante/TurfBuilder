# SCHEMA SERIALIZATION FORMAT GUIDE
# Lines beginning with "#" are meta-notes for the AI. Do NOT emit them as SQL.
# Lines beginning with "--" are SQL comments. Emit them as-is in the generated SQL.
# NULLABLE is explicit. All other fields are NOT NULL.
# FK -> schema.table.column indicates a foreign key reference.
# Enums are defined inline and should be created as PostgreSQL enum types.
# All timestamps should be TIMESTAMPTZ.
# All ids are UUID DEFAULT gen_random_uuid().
# All tables live in the "universe" schema unless otherwise specified.
# Emit "CREATE SCHEMA IF NOT EXISTS universe" before any table definitions.
#
# RLS NOTATION:
#   RLS ENABLED                   — emit ALTER TABLE x ENABLE ROW LEVEL SECURITY + FORCE ROW LEVEL SECURITY
#   POLICY public_read            — SELECT only, no org filter, visible to all
#   POLICY org_isolation          — USING (org_id = current_org_id) WITH CHECK (org_id = current_org_id)
#   POLICY public_entity_read     — USING (true) for SELECT only — all public entities visible to all
#   current_org_id resolves via:  NULLIF(current_setting('app.current_org_id', true), '')::uuid
#
# INDEX NOTATION:
#   INDEX (col)                   — standard btree index
#   INDEX (col) WHERE condition   — partial index
#   INDEX GIST (col)              — PostGIS spatial index
#   INDEX GIN (expr)              — full-text search index using to_tsvector('simple', expr)
#
# FK DELETE BEHAVIOUR NOTATION (append to FK declaration):
#   ON DELETE CASCADE             — delete this row when the referenced row is deleted
#   ON DELETE SET NULL            — set this column to NULL when the referenced row is deleted
#   ON DELETE RESTRICT            — prevent deletion of the referenced row if this row exists
#
# FK DELETE BEHAVIOUR RULES (apply globally unless overridden inline):
#   FK -> auth.organization.id    always ON DELETE CASCADE
#   FK -> auth.user.id            always ON DELETE SET NULL
#   FK -> universe.public_entity.id   always ON DELETE CASCADE
#   FK -> universe.org_entity.id      always ON DELETE CASCADE
#   FK -> universe.entity_type.id     always ON DELETE RESTRICT
#   FK -> universe.organization_type.id  always ON DELETE RESTRICT
#   FK -> universe.relationship_type.id  always ON DELETE RESTRICT
#   FK -> universe.tag.id         always ON DELETE CASCADE

