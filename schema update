-- =============================================================================
-- TAGGING SYSTEM
-- Flexible labelling for any entity. Tags are org-scoped and can be applied
-- to any public or org entity. Used to logically group data, drive plugin
-- behaviour, and mark entities for special handling (e.g. 'hostile', 'priority').
-- =============================================================================

TABLE universe.tag {
  -- Tags are scoped to an org. slug and name are each unique within an org
  -- but can be reused across different orgs independently.
  id:          UUID
  org_id:      FK -> auth.organization.id
  slug:        TEXT -- Machine-readable identifier. Unique per org. Must be kebab-case (e.g. 'hostile', 'high-priority', 'ward-4'). Enforced via CHECK constraint: only lowercase letters, numbers, and hyphens allowed. No leading or trailing hyphens.
  # CHECK CONSTRAINT on slug: slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'
  name:        TEXT -- Human-readable label. Unique per org. Independent of slug uniqueness.
  description: NULLABLE TEXT
  created_at:  TIMESTAMPTZ
  # UNIQUE CONSTRAINT on (org_id, slug)
  # UNIQUE CONSTRAINT on (org_id, name)
  # RLS ENABLED
  # POLICY org_isolation
  # INDEX (org_id)
}

TABLE universe.entity_tag {
  -- Join table between a tag and any entity (public or org-scoped).
  -- An entity can be tagged with the same tag only once.
  -- Supports cross-tier tagging — an org can tag a public entity.
  -- CONSTRAINT: exactly one of (public_entity_id, org_entity_id) must be set.
  id:               UUID
  tag_id:           FK -> universe.tag.id
  org_id:           FK -> auth.organization.id
  public_entity_id: NULLABLE FK -> universe.public_entity.id
  org_entity_id:    NULLABLE FK -> universe.org_entity.id
  tagged_by:        NULLABLE FK -> auth.user.id -- NULLABLE to support automated tagging by importers or system processes
  created_at:       TIMESTAMPTZ
  # UNIQUE CONSTRAINT on (tag_id, public_entity_id) WHERE public_entity_id IS NOT NULL
  # UNIQUE CONSTRAINT on (tag_id, org_entity_id)    WHERE org_entity_id IS NOT NULL
  # RLS ENABLED
  # POLICY org_isolation
  # INDEX (org_id)
  # INDEX (tag_id)
  # INDEX (public_entity_id)  WHERE public_entity_id IS NOT NULL
  # INDEX (org_entity_id)     WHERE org_entity_id IS NOT NULL
}
