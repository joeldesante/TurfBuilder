		"@xstate/svelte": "^5.0.0",
		"better-auth": "^1.4.9",
		"bits-ui": "^2.18.1",
		"carta-md": "^4.11.2",
		"codemirror": "^6.0.2",
		"d3": "^7.9.0",
		"dompurify": "^3.4.4",
		"dotenv": "^17.2.3",
		"hyparquet": "^1.26.0",
		"import-in-the-middle": "^3.0.1",
		"maplibre-gl": "^5.15.0",
		"marked": "^18.0.3",
		"nanoid": "^5.1.6",
		"nodemailer": "^8.0.7",
		"papaparse": "^5.5.3",
		"pdf-lib": "^1.17.1",
		"pg": "^8.16.3",
		"qrcode": "^1.5.4",
		"remark-ins": "^1.2.4",
		"robot3": "^1.2.0",
		"svelte-time": "^2.1.0",
		"zod": "^4.3.6",
		"zod-empty": "^2.0.2"
	},
	"overrides": {
		"vitest": "$vitest"
	}
}
