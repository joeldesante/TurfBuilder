{
	"name": "turfbuilder",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test": "npm run test:e2e && npm run test:unit",
		"test:unit": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"lint": "eslint .",
		"format": "prettier --write .",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build",
		"db": "NODE_ENV=development node-pg-migrate -j ts --database-url-var MIGRATION_DATABASE_URL",
		"db:prod": "NODE_ENV=production node-pg-migrate -j ts --database-url-var MIGRATION_DATABASE_URL",
		"docs": "tsx scripts/build-docs.ts",
		"import:locations": "tsx scripts/import-locations.ts",
		"new:component": "node scripts/new-component.js",
		"docs:dev": "npm run docs && vitepress dev docs",
		"docs:build": "npm run docs && vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"deploy:functions": "doctl serverless deploy cloud-functions --verbose-build --remote-build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^4.1.3",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
