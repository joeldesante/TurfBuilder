-- =============================================================================
-- RELATIONSHIP TABLES
-- Temporal connections between entities. Never update — close old rows with
-- valid_to and insert new ones. valid_to IS NULL means the relationship is active.
-- =============================================================================

TABLE universe.public_relationship {
  -- Connects two public entities. Globally visible, not org-scoped.
  -- Both sides must reference universe.public_entity.
  id:                   UUID
  from_entity_id:       FK -> universe.public_entity.id
  to_entity_id:         FK -> universe.public_entity.id
  relationship_type_id: FK -> universe.relationship_type.id
  valid_from:           TIMESTAMPTZ
  valid_to:             NULLABLE TIMESTAMPTZ
  authored_by:          NULLABLE FK -> auth.user.id
  source:               TEXT -- What created this relationship (e.g. 'overture', 'org_import', 'crowdsource')
  created_at:           TIMESTAMPTZ
  # RLS ENABLED
  # POLICY public_entity_read -- public relationships are visible to all orgs
  # INDEX (from_entity_id)
  # INDEX (to_entity_id)
  # INDEX (from_entity_id) WHERE valid_to IS NULL -- active relationships from an entity
  # INDEX (to_entity_id)   WHERE valid_to IS NULL -- active relationships to an entity
  # INDEX (relationship_type_id)
}

TABLE universe.org_relationship {
  -- Connects any two entities where at least one side is org-scoped.
  -- Always private to the owning org. Handles cross-tier links (e.g. an org person
  -- living at a public location) via nullable FK pairs on each side.
  -- CONSTRAINT: exactly one of (from_public_entity_id, from_org_entity_id) must be set.
  -- CONSTRAINT: exactly one of (to_public_entity_id, to_org_entity_id) must be set.
  id:                    UUID
  org_id:                FK -> auth.organization.id
  from_public_entity_id: NULLABLE FK -> universe.public_entity.id
  from_org_entity_id:    NULLABLE FK -> universe.org_entity.id
  to_public_entity_id:   NULLABLE FK -> universe.public_entity.id
  to_org_entity_id:      NULLABLE FK -> universe.org_entity.id
  relationship_type_id:  FK -> universe.relationship_type.id
  valid_from:            TIMESTAMPTZ
  valid_to:              NULLABLE TIMESTAMPTZ
  authored_by:           NULLABLE FK -> auth.user.id
  source:                TEXT -- What created this relationship (e.g. 'org_import', 'crowdsource')
  created_at:            TIMESTAMPTZ
  # RLS ENABLED
  # POLICY org_isolation
  # INDEX (org_id)
  # INDEX (from_public_entity_id) WHERE from_public_entity_id IS NOT NULL
  # INDEX (from_org_entity_id)    WHERE from_org_entity_id IS NOT NULL
  # INDEX (to_public_entity_id)   WHERE to_public_entity_id IS NOT NULL
  # INDEX (to_org_entity_id)      WHERE to_org_entity_id IS NOT NULL
  # INDEX (org_id, relationship_type_id) WHERE valid_to IS NULL -- active relationships by type within an org
}

