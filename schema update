-- =============================================================================
-- VERSION TABLES (public)
-- Append-only. Never update — insert a new row and set valid_to on the old one.
-- valid_to IS NULL means the current/active version.
-- valid_from is when the data became true in the real world.
-- created_at is when we recorded it — these can differ for historical imports.
-- authored_by is the user who created this version. NULLABLE for system/importer-created versions.
-- source indicates what process created this version row.
-- =============================================================================

TABLE universe.public_person {
  -- A person record shared across all orgs (e.g. loaded from a national voter file at infrastructure level).
  -- All identifying fields are nullable — we may only have partial data depending on the source.
  id:             UUID
  entity_id:      FK -> universe.public_entity.id
  first_name:     NULLABLE TEXT
  middle_name:    NULLABLE TEXT
  last_name:      NULLABLE TEXT
  suffix:         NULLABLE TEXT -- e.g. 'Jr.', 'Sr.', 'III'
  preferred_name: NULLABLE TEXT -- goes by a nickname or preferred first name
  dob:            NULLABLE DATE
  phone:          NULLABLE TEXT
  email:          NULLABLE TEXT
  gender:         NULLABLE TEXT
  attributes:     NULLABLE JSONB -- Domain-specific overflow fields (e.g. 'party_affiliation' for canvassing, 'account_tier' for sales)
  valid_from:     TIMESTAMPTZ
  valid_to:       NULLABLE TIMESTAMPTZ
  authored_by:    NULLABLE FK -> auth.user.id
  source:         TEXT -- What created this version (e.g. 'voter_file', 'overture', 'crowdsource')
  created_at:     TIMESTAMPTZ
  # RLS ENABLED
  # POLICY public_entity_read -- public person versions are visible to all orgs
  # INDEX (entity_id)
  # INDEX (entity_id) WHERE valid_to IS NULL -- fast current-version lookup
  # INDEX (last_name, first_name) -- name search
  # INDEX GIN (COALESCE(first_name,'') || ' ' || COALESCE(middle_name,'') || ' ' || COALESCE(last_name,'') || ' ' || COALESCE(preferred_name,'')) -- full-text name search
}

TABLE universe.public_organization {
  -- A publicly shared organization entity (business, non-profit, government body, etc.).
  id:          UUID
  entity_id:   FK -> universe.public_entity.id
  type_id:     NULLABLE FK -> universe.organization_type.id -- NULLABLE because type may not always be known at import time.
  name:        TEXT
  phone:       NULLABLE TEXT
  email:       NULLABLE TEXT
  website:     NULLABLE TEXT
  attributes:  NULLABLE JSONB -- Domain-specific overflow fields
  valid_from:  TIMESTAMPTZ
  valid_to:    NULLABLE TIMESTAMPTZ
  authored_by: NULLABLE FK -> auth.user.id
  source:      TEXT -- What created this version (e.g. 'overture', 'org_import', 'crowdsource')
  created_at:  TIMESTAMPTZ
  # RLS ENABLED
  # POLICY public_entity_read -- public organization versions are visible to all orgs
  # INDEX (entity_id)
  # INDEX (entity_id) WHERE valid_to IS NULL -- fast current-version lookup
  # INDEX (name) -- name search
  # INDEX GIN (name) -- full-text name search
}

TABLE universe.public_location {
  -- A physical location in the world. All address fields are nullable to support
  -- informal addresses, coordinate-only locations, and mobile locations.
  id:              UUID
  entity_id:       FK -> universe.public_entity.id
  name:            NULLABLE TEXT -- e.g. 'Central Park', 'Empire State Building', 'Coachella Grounds'
  address_line_1:  NULLABLE TEXT
  address_line_2:  NULLABLE TEXT
  address_line_3:  NULLABLE TEXT
  city:            NULLABLE TEXT
  state_or_region: NULLABLE TEXT
  postal_code:     NULLABLE TEXT
  country_code:    NULLABLE TEXT
  coordinates:     NULLABLE GEOMETRY(POINT, 4326) -- NULLABLE because some locations may have an address but no geocoded coordinates yet
  valid_from:      TIMESTAMPTZ
  valid_to:        NULLABLE TIMESTAMPTZ
  authored_by:     NULLABLE FK -> auth.user.id
  source:          TEXT -- What created this version (e.g. 'overture', 'org_import', 'crowdsource')
  created_at:      TIMESTAMPTZ
  # RLS ENABLED
  # POLICY public_entity_read -- public location versions are visible to all orgs
  # INDEX (entity_id)
  # INDEX (entity_id) WHERE valid_to IS NULL -- fast current-version lookup
  # INDEX GIST (coordinates) -- spatial queries
  # INDEX (city)
  # INDEX (postal_code)
  # INDEX GIN (COALESCE(name,'') || ' ' || COALESCE(address_line_1,'') || ' ' || COALESCE(city,'') || ' ' || COALESCE(postal_code,'')) -- full-text address search
}

