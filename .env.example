# The connection string for your PostgreSQL database.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgres://postgres:db_password@localhost:5432/postgres"

# Secret key used to encrypt session cookies and sensitive auth data.
# Changing this will invalidate all active sessions.
# Do NOT use this value in production — generate a new one at:
# https://www.better-auth.com/docs/installation#set-environment-variables
BETTER_AUTH_SECRET="ODiDH4PwSD2KxDoVu7jVfkxooICq5m1P"

# Access keys for object storage (DigitalOcean Spaces or any S3-compatible
# service), which holds location photos and generated list PDFs. Optional for
# local development: without them, photo uploads and PDF generation report that
# storage is not set up. The endpoint, region, and bucket are runtime settings
# at /infra/settings, not environment variables.
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_ACCESS_KEY=""
