# ('resident',         'residence_of',        'Resident',         'Residence Of',      'A person resides at a location')
# ('employed_by',      'employs',             'Employed By',      'Employs',           'A person is employed by an organization')
# ('owned_by',         'owns',                'Owned By',         'Owns',              'An entity is owned by another entity')
# ('member_of',        'has_member',          'Member Of',        'Has Member',        'A person is a member of an organization')
# ('subsidiary_of',    'has_subsidiary',      'Subsidiary Of',    'Has Subsidiary',    'An organization is a subsidiary of another')
# ('delivers_to',      'delivered_by',        'Delivers To',      'Delivered By',      'An entity delivers to a location or organization')

